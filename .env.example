# Synthetic demo only. No real credentials or bearer tokens belong in this file.
GATEWAY_IDENTITY_MODE=demo
GATEWAY_SOURCE=synthetic_postgres
# Public gateway/edge ingress binding, never 0.0.0.0 for the demo.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PUBLIC_INGRESS=false
GATEWAY_TRUST_FORWARDED_HEADERS=false
# Operator-selected, private external file; mount it read-only into the gateway.
# GATEWAY_CREDENTIAL_HASH_FILE=/absolute/local/path/credential-hashes.json

# Production access-token verification is disabled until every setting is present.
# These illustrative values do not configure Studio or create an issuer account.
# GATEWAY_IDENTITY_MODE=production
# GATEWAY_SOURCE=bigquery
# GATEWAY_OIDC_ISSUER=https://issuer.example.test
# GATEWAY_OIDC_AUDIENCE=gateway-api
# GATEWAY_OIDC_JWKS_URL=https://issuer.example.test/keys
# GATEWAY_OIDC_ACCESS_TOKEN_PROFILE=rfc9068
# GATEWAY_OIDC_CLIENT_IDS=approved-agent-client
# GATEWAY_OIDC_ALLOWED_ALGORITHMS=RS256
# GATEWAY_OIDC_JWKS_CACHE_SECONDS=300
# GATEWAY_OIDC_REQUEST_TIMEOUT_SECONDS=2.0
