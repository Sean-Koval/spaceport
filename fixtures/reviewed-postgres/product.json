{
  "schema_version": "1.0",
  "product_id": "bookings",
  "version": "1.0.0",
  "name": "Reviewed daily bookings",
  "description": "Synthetic reviewed v2 bookings with a same-statement committed-load checkpoint.",
  "examples": [
    {
      "description": "Three-day north revenue",
      "inputs": {
        "start": "2024-03-09",
        "end": "2024-03-12"
      }
    }
  ],
  "owner": "analytics",
  "domain": "finance",
  "links": [
    {
      "label": "Definition",
      "url": "https://example.com/revenue"
    }
  ],
  "inputs": {
    "start": {
      "type": "date",
      "nullable": false,
      "required": true,
      "enum": null,
      "default": null,
      "precision": null,
      "scale": null
    },
    "end": {
      "type": "date",
      "nullable": false,
      "required": true,
      "enum": null,
      "default": null,
      "precision": null,
      "scale": null
    },
    "segment": {
      "type": "string",
      "nullable": true,
      "required": false,
      "enum": [
        "A",
        "B"
      ],
      "default": {
        "value": null
      },
      "precision": null,
      "scale": null
    }
  },
  "outputs": {
    "day": {
      "type": "date",
      "nullable": false,
      "required": true,
      "enum": null,
      "default": null,
      "precision": null,
      "scale": null
    },
    "segment": {
      "type": "string",
      "nullable": true,
      "required": true,
      "enum": null,
      "default": null,
      "precision": null,
      "scale": null
    },
    "revenue": {
      "type": "decimal",
      "nullable": false,
      "required": true,
      "enum": null,
      "default": null,
      "precision": 38,
      "scale": 2
    }
  },
  "filters": {
    "segment": {
      "operators": [
        "eq",
        "in",
        "is_null"
      ],
      "max_values": 10
    },
    "day": {
      "operators": [
        "eq",
        "gte",
        "lt"
      ],
      "max_values": 100
    }
  },
  "sort": {
    "fields": [
      "day",
      "segment"
    ],
    "max_fields": 2
  },
  "grain": "daily",
  "units": {
    "revenue": {
      "unit": "money",
      "currency": "USD"
    }
  },
  "timezone": "America/New_York",
  "date_boundaries": {
    "start_input": "start",
    "end_input": "end",
    "interval": "[start,end)"
  },
  "aggregation": "Sum of order amounts",
  "freshness": {
    "required": true,
    "max_age_seconds": 86400,
    "meaning": "source_load"
  },
  "binding_id": "bookings-reviewed",
  "binding_revision": 1,
  "adapter_revision": "cube-rest-v2",
  "policy_id": "bookings-access",
  "classification": "internal",
  "redaction": {
    "start": "digest",
    "end": "digest",
    "segment": "omit"
  },
  "fixtures": [
    {
      "id": "north-total",
      "version": "1",
      "inputs": {
        "start": "2024-03-09",
        "end": "2024-03-12"
